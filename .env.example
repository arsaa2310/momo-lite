# Salin ke .env lalu sesuaikan
WEB_PORT=8095          # aplikasi (Super Admin, Central Admin, Purchasing)
DB_PORT=5434           # PostgreSQL di komputer host
DB_PASSWORD=lite       # hanya berlaku saat database PERTAMA kali dibuat
JWT_SECRET=ganti-dengan-rahasia-panjang   # openssl rand -hex 32
COOKIE_SECURE=false    # true bila dibuka lewat https://
# Super Admin pertama (dibuat otomatis bila belum ada)
ADMIN_EMAIL=admin@lite.id
ADMIN_PASSWORD=admin12345
